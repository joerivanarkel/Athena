<div class="max-w-2xl mx-auto mt-8">
    <h1 class="text-4xl font-bold text-gray-800 mb-2">Athena</h1>
    <p class="text-gray-500 mb-8">A worldbuilding encyclopedia.</p>

    @foreach (var group in Articles.GroupBy(a => a.Meta.Category).OrderBy(g => g.Key))
    {
        <section class="mb-6">
            <h2 class="text-lg font-semibold text-gray-600 uppercase tracking-wide mb-2 border-b border-gray-200 pb-1">
                @(string.IsNullOrEmpty(group.Key) ? "Uncategorized" : group.Key)
            </h2>
            <ul class="space-y-1">
                @foreach (var article in group.OrderBy(a => a.Meta.Title))
                {
                    <li>
                        <a href="@article.Meta.Slug" class="text-blue-600 hover:underline text-base">
                            @article.Meta.Title
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AthenaDocument> Articles { get; set; } = [];
}
