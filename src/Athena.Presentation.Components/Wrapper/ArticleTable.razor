@if (!string.IsNullOrEmpty(Title))
{
    <h3 class="sub">@Title</h3>
}

<table>
    <thead>
        <tr>
            @TableHeaders
        </tr>
    </thead>
    <tbody>
        @TableRows
    </tbody>
</table>

@code {
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public RenderFragment TableHeaders { get; set; }
    [Parameter]
    public RenderFragment TableRows { get; set; }
}
