@if (!string.IsNullOrEmpty(Title))
{
    @if (Level >= 2)
    {
        <h3 class="sub" id="@SluggedTitle">@Title</h3>
    }
    else
    {
        <h2 class="section" id="@SluggedTitle">@Title</h2>
    }
}
@ChildContent

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public int Level { get; set; } = 1;

    private string SluggedTitle => Title?.ToLowerInvariant().Replace(' ', '-') ?? "";
}
