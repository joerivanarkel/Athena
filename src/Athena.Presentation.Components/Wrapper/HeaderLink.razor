@inject NavigationManager NavigationManager

<li>
    <a href="@($"{GetBaseUri()}#{Href}")">@Value</a>
</li>

@code {
    [Parameter] public string Value { get; set; }
    [Parameter] public string Href { get; set; }

    private string GetBaseUri()
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var hashIndex = relativeUri.IndexOf('#');
        return hashIndex >= 0 ? relativeUri.Substring(0, hashIndex) : relativeUri;
    }
}
