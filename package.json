{
  "scripts": {
    "sass": "sass --load-path=node_modules",
    "sass:ssg": "sass --load-path=node_modules --style=compressed src/Athena.Ssg/Styles:src/Athena.Ssg/wwwroot/css",
    "sass:components": "sass --load-path=node_modules --style=compressed src/Athena.Presentation.Components/Styles:src/Athena.Presentation.Components/wwwroot/css",
    "build:css": "tailwindcss -i ./src/Athena.Ssg/wwwroot/css/app.css -o ./src/Athena.Ssg/wwwroot/css/app.css --minify",
    "build:styles": "npm run sass:ssg && npm run sass:components && npm run build:css"
  },
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6"
  },
  "devDependencies": {
    "sass": "^1.69.5"
  }
}
